# syntax=docker/dockerfile:1
#
# The Linux CI environment, runnable locally; the build fails if any check fails:
#
#   docker buildx build -f Dockerfile.test .

FROM eclipse-temurin:25-jdk-noble
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgtk-3-0t64 libwebkit2gtk-4.1-0 libxtst6 xvfb \
    && rm -rf /var/lib/apt/lists/*

# No GPU in a container: keep WebKit on the software path.
ENV GDK_BACKEND=x11 \
    WEBKIT_DISABLE_DMABUF_RENDERER=1 \
    WEBKIT_DISABLE_COMPOSITING_MODE=1

WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/root/.gradle \
    ./gradlew --no-daemon --console=plain spotlessCheck checkstyleMain checkstyleTest checkstyleTestFixtures test \
    && xvfb-run -a ./gradlew --no-daemon --console=plain displayTest -Dlwjwae.requireDisplay=true -Dlwjwae.screenshots=true
