# syntax=docker/dockerfile:1
#
# The Linux CI environment as an image: Ubuntu 24.04, the JDK, GTK 3 and 4, WebKitGTK 4.1 and 6.0,
# Xvfb, a session bus, and a notification server. No GPU: everything draws in software.
# scripts/linux/test-in-docker.sh builds it and runs the tests in it against the working tree.

FROM eclipse-temurin:25-jdk-noble
COPY linux/install-test-packages.sh /tmp/
RUN /tmp/install-test-packages.sh && rm -rf /var/lib/apt/lists/* /tmp/install-test-packages.sh

# The environment of the CI job: GTK on X11 for Xvfb, WebKit and GTK 4 on the software path.
ENV GDK_BACKEND=x11 \
    WEBKIT_DISABLE_DMABUF_RENDERER=1 \
    WEBKIT_DISABLE_COMPOSITING_MODE=1 \
    GSK_RENDERER=cairo \
    LIBGL_ALWAYS_SOFTWARE=1 \
    GRADLE_OPTS=--enable-native-access=ALL-UNNAMED

# A user of its own, as on CI, with the uid of whoever builds the image, so that the reports that
# the script copies out belong to them.
ARG UID=1000
RUN useradd --create-home --uid "$UID" --non-unique tester \
    && mkdir -p /work /home/tester/.gradle \
    && chown tester /work /home/tester/.gradle
USER tester
WORKDIR /work
